# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FINNHUB_API_KEY: 미국 주식 실시간 시세 조회를 위한 Finnhub 무료 API 키 (분당 60회 이하 제한 준수)
FINNHUB_API_KEY=""

# SEC_USER_AGENT: 미국 SEC EDGAR companyfacts API 호출 시 필수 헤더 (이름 이메일 형식, 초당 10회 이하 제한 준수)
SEC_USER_AGENT="GlobalStockInsight sungwoo.ju@gmail.com"
